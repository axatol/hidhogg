{
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "configuration schema version",
      "enum": [
        3
      ]
    },
    "adapter": {
      "type": "string",
      "description": "device adapter identifier",
      "enum": [
        "ulanzi.d200x"
      ]
    },
    "brightness": {
      "type": "integer",
      "description": "display brightness percentage",
      "minimum": 0,
      "maximum": 100
    },
    "idle_timeout_seconds": {
      "type": "integer",
      "description": "application-owned idle timeout in seconds",
      "default": 300,
      "minimum": 0,
      "maximum": 86400
    },
    "default_profile_id": {
      "type": "string",
      "description": "profile selected at startup",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "case-sensitive stable profile identifier",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "label": {
            "type": "string",
            "description": "display profile label",
            "minLength": 1,
            "maxLength": 64
          },
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "stable position identifier",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                },
                "position": {
                  "type": "string",
                  "description": "supported D200X grid position",
                  "enum": [
                    "0_0",
                    "1_0",
                    "2_0",
                    "3_0",
                    "4_0",
                    "0_1",
                    "1_1",
                    "2_1",
                    "3_1",
                    "4_1",
                    "0_2",
                    "1_2",
                    "2_2",
                    "3_2"
                  ]
                },
                "label": {
                  "type": "string",
                  "description": "display label",
                  "minLength": 1,
                  "maxLength": 64
                },
                "background": {
                  "type": "string",
                  "description": "hexadecimal background colour",
                  "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
                },
                "label_alignment": {
                  "type": "string",
                  "description": "firmware-rendered label alignment",
                  "default": "bottom",
                  "enum": [
                    "bottom",
                    "center"
                  ]
                },
                "label_size": {
                  "type": "integer",
                  "description": "firmware-rendered label size",
                  "default": 10,
                  "minimum": 8,
                  "maximum": 32
                },
                "action": {
                  "description": "optional input-gesture action binding",
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "action type",
                          "enum": [
                            "activate_profile"
                          ]
                        },
                        "gesture": {
                          "type": "string",
                          "description": "input gesture; defaults to release when omitted",
                          "default": "release",
                          "enum": [
                            "press",
                            "release"
                          ]
                        },
                        "profile_id": {
                          "type": "string",
                          "description": "case-sensitive target profile identifier",
                          "minLength": 1,
                          "maxLength": 64,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                        }
                      },
                      "required": [
                        "type",
                        "profile_id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "action type",
                          "enum": [
                            "execute"
                          ]
                        },
                        "gesture": {
                          "type": "string",
                          "description": "input gesture; defaults to release when omitted",
                          "default": "release",
                          "enum": [
                            "press",
                            "release"
                          ]
                        },
                        "executable": {
                          "type": "string",
                          "description": "absolute executable path without NUL",
                          "minLength": 1,
                          "pattern": "^/[^\\x00]*$"
                        },
                        "arguments": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "maxLength": 1024,
                            "pattern": "^[^\\x00]*$"
                          },
                          "description": "executable arguments; Go semantic validation authoritatively enforces UTF-8 byte and aggregate argument bounds because JSON Schema maxLength is character-based and cannot express aggregate encoded bytes",
                          "default": [],
                          "maxItems": 32
                        },
                        "timeout_seconds": {
                          "type": "integer",
                          "description": "maximum synchronous execution time in seconds",
                          "default": 10,
                          "minimum": 1,
                          "maximum": 60
                        }
                      },
                      "required": [
                        "type",
                        "executable"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "action type",
                          "enum": [
                            "type_text"
                          ]
                        },
                        "gesture": {
                          "type": "string",
                          "description": "input gesture; defaults to release when omitted",
                          "default": "release",
                          "enum": [
                            "press",
                            "release"
                          ]
                        },
                        "text": {
                          "type": "string",
                          "description": "non-empty UTF-8 text without NUL; Go semantic validation authoritatively enforces the maximum of 64 UTF-16 code units",
                          "minLength": 1,
                          "maxLength": 64,
                          "pattern": "^[^\\x00]*$"
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "description": "action type",
                          "enum": [
                            "key_press"
                          ]
                        },
                        "gesture": {
                          "type": "string",
                          "description": "input gesture; defaults to release when omitted",
                          "default": "release",
                          "enum": [
                            "press",
                            "release"
                          ]
                        },
                        "key": {
                          "type": "string",
                          "description": "physical key; only enter is supported",
                          "enum": [
                            "enter"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "key"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "position",
                "label",
                "background"
              ],
              "additionalProperties": false
            },
            "description": "all supported D200X display positions",
            "minItems": 14,
            "maxItems": 14,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "label",
          "positions"
        ],
        "additionalProperties": false
      },
      "description": "ordered configured display profiles",
      "minItems": 1,
      "maxItems": 31,
      "uniqueItems": true
    }
  },
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Hidhogg Ulanzi D200X configuration v3",
  "description": "Strict named-profile configuration for one Ulanzi D200X adapter.",
  "required": [
    "schema_version",
    "adapter",
    "brightness",
    "default_profile_id",
    "profiles"
  ],
  "additionalProperties": false
}
